# Copy to backend/.env and replace every placeholder before production startup.
DJANGO_SECRET_KEY=replace-with-at-least-32-random-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=jobs.example.com
CSRF_TRUSTED_ORIGINS=https://jobs.example.com
DATABASE_URL=postgres://jobs:replace-with-db-password@db:5432/jobs
REDIS_URL=redis://redis:6379/0
USE_REDIS_SESSIONS=1
SESSION_COOKIE_SECURE=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_HSTS_PRELOAD=0
FRONTEND_URL=https://jobs.example.com
TELEGRAM_AUTH_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_AUTH_BOT_USERNAME=jobsdev_bot
HH_API_TOKEN=
HH_USER_AGENT=jobs.dev/1.0 (support@jobs.dev)
# Mount the generated catalog or jobs.sqlite3 into the API container in production.
VACANCY_CATALOG_PATH=/app/catalog/vacancies.json
# JOB_TRACKER_DB_PATH=/app/catalog/jobs.sqlite3
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=ru-central1
