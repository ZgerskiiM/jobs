{
  "manifest_version": 2,
  "name": "jobs.dev — быстрый отклик",
  "version": "0.1.0",
  "description": "Заполняет форму отклика ASTON данными активного резюме из jobs.dev.",
  "permissions": [
    "tabs",
    "https://jobs-dev.zgerskiim.chatgpt.site/*"
  ],
  "browser_action": {
    "default_title": "Заполнить отклик из jobs.dev",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://career.astondevs.ru/vacancy/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "applications": {
    "gecko": {
      "id": "apply@jobs.dev",
      "strict_min_version": "109.0"
    }
  }
}
