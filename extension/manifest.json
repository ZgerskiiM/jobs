{
  "manifest_version": 2,
  "name": "devver — быстрый отклик",
  "version": "0.4.8",
  "description": "Заполняет формы отклика и отмечает отправленные отклики в devver.",
  "permissions": [
    "activeTab",
    "tabs",
    "<all_urls>",
    "https://devver.ru/*"
  ],
  "browser_action": {
    "default_title": "Заполнить отклик из devver",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "applications": {
    "gecko": {
      "id": "apply@jobs.dev",
      "strict_min_version": "109.0"
    }
  }
}
